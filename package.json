{
  "name": "keyboard-warrior",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Keyboard Warrior Max for Live device",
  "scripts": {
    "build": "node scripts/build-windows.mjs",
    "build:watch": "node scripts/build-windows.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prettier:fix": "prettier --write ."
  },
  "prettier": "./prettier.config.cjs",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/maxmsp": "1.0.16",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  }
}
